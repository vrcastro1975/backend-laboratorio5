# Copy this file to .env and fill your values.
# The .env file must stay local and never be committed.

PORT=3000
DATA_SOURCE=mock
MONGO_DB_NAME=airbnb

# Local Mongo (default)
MONGO_URI=mongodb://mongo-db:27017

# Atlas example:
# MONGO_URI=mongodb+srv://<user>:<password>@<cluster-url>/?retryWrites=true&w=majority

# Portadas desde S3 (LocalStack o AWS). Si defines bucket y URL pública, la API
# devuelve imágenes bajo esa base en lugar de la primera URL de photos.
# S3_BUCKET_LISTING_IMAGES=lab5-listings
# S3_ENDPOINT_URL=http://localstack:4566
# S3_PUBLIC_BASE_URL=http://localhost:4566
# AWS_ACCESS_KEY_ID=test
# AWS_SECRET_ACCESS_KEY=test
# AWS_REGION=us-east-1
